{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowassist.local/schemas/flowassist-v2/envelope.agent-to-client.schema.json",
  "title": "flowassist/v2 — komunikat agent → klient",
  "description": "Pochodna specyfikacja (plan v1.3.2, P0.3). Autorytet runtime: contract.ts: parseEvent. Zmiana guardów pod schemat = jawna zmiana kontraktu. Dokładnie jeden klucz payloadu (stage | narration | createSurface | updateComponents | updateDataModel | deleteSurface); mieszana koperta jest odrzucana w całości (OBS-4). Pola niebędące payloadem (np. version przy rozszerzeniu) są ignorowane.",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "stage"
      ]
    },
    {
      "required": [
        "narration"
      ]
    },
    {
      "required": [
        "createSurface"
      ]
    },
    {
      "required": [
        "updateComponents"
      ]
    },
    {
      "required": [
        "updateDataModel"
      ]
    },
    {
      "required": [
        "deleteSurface"
      ]
    }
  ],
  "if": {
    "required": [
      "stage"
    ]
  },
  "then": {
    "properties": {
      "stage": {
        "type": "object",
        "required": [],
        "properties": {
          "focus": {
            "enum": [
              "front",
              "back"
            ]
          },
          "drawer": {
            "enum": [
              "open",
              "closed"
            ]
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      }
    }
  },
  "else": {
    "if": {
      "required": [
        "narration"
      ]
    },
    "then": {
      "properties": {
        "narration": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "speak": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "else": {
      "$ref": "#/$defs/a2ui"
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/noReservedKeys"
    }
  ],
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "component"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          },
          "description": "FU-4: id staje się kluczem mapy komponentów — nazwy zarezerwowane odrzucane"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          }
        }
      }
    },
    "a2ui": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "enum": [
            "v0.9",
            "v0.9.1"
          ],
          "description": "OBS-3: v0.9 tolerowane na wejściu do czasu handshake'u (ADR 0002, 0005)"
        },
        "createSurface": {
          "type": "object",
          "required": [
            "surfaceId",
            "catalogId"
          ],
          "properties": {
            "surfaceId": {
              "enum": [
                "workspace",
                "tasks-drawer",
                "hud"
              ]
            },
            "catalogId": {
              "const": "flowassist/v2"
            }
          }
        },
        "updateComponents": {
          "type": "object",
          "required": [
            "surfaceId",
            "components"
          ],
          "properties": {
            "surfaceId": {
              "enum": [
                "workspace",
                "tasks-drawer",
                "hud"
              ]
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/component"
              }
            }
          }
        },
        "updateDataModel": {
          "type": "object",
          "required": [
            "surfaceId"
          ],
          "properties": {
            "surfaceId": {
              "enum": [
                "workspace",
                "tasks-drawer",
                "hud"
              ]
            },
            "path": {
              "type": "string",
              "description": "FU-3 / ADR 0002: limit zasobów — ≤ 512 punktów kodowych Unicode (jednostka maxLength) i ≤ 32 segmenty (contract.ts: PROTOCOL_LIMITS); FU-4: segment o nazwie zarezerwowanej odrzucany",
              "maxLength": 512,
              "pattern": "^(?!.*/(?:__proto__|constructor|prototype)(?:/|$))(/[^/]*){0,32}$"
            },
            "value": {}
          }
        },
        "deleteSurface": {
          "type": "object",
          "required": [
            "surfaceId"
          ],
          "properties": {
            "surfaceId": {
              "enum": [
                "workspace",
                "tasks-drawer",
                "hud"
              ]
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "createSurface"
          ]
        },
        {
          "required": [
            "updateComponents"
          ]
        },
        {
          "required": [
            "updateDataModel"
          ]
        },
        {
          "required": [
            "deleteSurface"
          ]
        }
      ]
    },
    "noReservedKeys": {
      "description": "FU-4 (contract.ts: RESERVED_KEYS): zarezerwowane klucze własne odrzucane na każdym poziomie ładunku",
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/noReservedKeys"
      },
      "items": {
        "$ref": "#/$defs/noReservedKeys"
      }
    }
  }
}
