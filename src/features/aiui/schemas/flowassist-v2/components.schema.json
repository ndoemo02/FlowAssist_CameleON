{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowassist.local/schemas/flowassist-v2/components.schema.json",
  "title": "flowassist/v2 — propsy komponentów po rozwiązaniu bindingów",
  "description": "Pochodna specyfikacja (plan v1.3.2, P0.3). Autorytet runtime: catalog.ts: validateProps. Zmiana guardów pod schemat = jawna zmiana kontraktu. Przyjęta koperta może dać pending (brak danych bindingu): ta warstwa sprawdza propsy dopiero po ich rozwiązaniu.",
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "name",
        "label"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "primary",
            "secondary"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "title",
        "status",
        "progress"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "done",
            "failed"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agent": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "TaskList": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "Approval": {
      "type": "object",
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Workspace": {
      "description": "członkostwo i kolejność obsługuje workspace.ts; children mogą wskazywać jeszcze niedostarczone komponenty (P6: legalne, nie błąd)"
    },
    "WorkspaceItem": {
      "type": "object",
      "required": [
        "kind",
        "title",
        "representations",
        "content"
      ],
      "properties": {
        "kind": {
          "enum": [
            "chart",
            "kpi",
            "table",
            "map",
            "slides"
          ]
        },
        "title": {
          "type": "string"
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "chart2d",
              "cards2d",
              "table2d",
              "map2d",
              "slides2d",
              "liquid3d",
              "ribbon3d",
              "kpi3d"
            ]
          }
        },
        "presentation": {
          "enum": [
            "card",
            "focus",
            "screen"
          ]
        },
        "priority": {
          "type": "number"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "content": {
          "type": "object",
          "description": "treść po rozwiązaniu bindingu; kształt zależy od reprezentacji (content.schema.json)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "chart"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "representations": {
                "items": {
                  "enum": [
                    "chart2d",
                    "ribbon3d",
                    "liquid3d"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "kpi"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "representations": {
                "items": {
                  "enum": [
                    "cards2d",
                    "kpi3d"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "representations": {
                "items": {
                  "enum": [
                    "table2d"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "map"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "representations": {
                "items": {
                  "enum": [
                    "map2d"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "slides"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "representations": {
                "items": {
                  "enum": [
                    "slides2d"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
